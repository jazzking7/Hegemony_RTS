{
  "name": "command-radius",
  "version": "0.1.0",
  "private": true,
  "description": "Command Radius browser RTS and authoritative multiplayer server",
  "type": "module",
  "main": "dist/server/main.js",
  "scripts": {
    "dev": "tsx watch server/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server/main.js",
    "test": "npm run test:multiplayer && npm run test:game",
    "test:all": "npm test && npm run test:smoke",
    "test:multiplayer": "node --import tsx --test server/domain/lobby-policy.test.ts",
    "test:lobby-live": "node --import tsx server/lobby-smoke.ts",
    "test:game": "node tests/regression.js",
    "test:smoke": "node tests/run-smoke.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@colyseus/schema": "^5.0.8",
    "@colyseus/sdk": "^0.18.1",
    "colyseus": "^0.18.1",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
